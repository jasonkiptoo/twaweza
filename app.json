{
  "expo": {
    "name": "SaveSmart",
    "slug": "savesmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/savesmart-icon.png",
    "scheme": "savesmart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/savesmart-icon.png"
    },
    "android": {
      "package": "com.savesmart.app",
      "adaptiveIcon": {
        "backgroundColor": "#2457FF",
        "foregroundImage": "./assets/images/savesmart-adaptive-foreground.png",
        "monochromeImage": "./assets/images/savesmart-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/savesmart-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2457FF",
          "image": "./assets/images/savesmart-splash.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appEnvironment": "development",
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
